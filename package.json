{
  "name": "dsh-antigravity",
  "version": "0.1.0",
  "description": "Google Antigravity / Cloud Code Assist model provider for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "bin",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets",
    "assets/images"
  ],
  "bin": {
    "dsh-antigravity-login": "bin/dsh-antigravity-login.mjs",
    "antigravity-login": "bin/dsh-antigravity-login.mjs"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/catalog.js && node --check lib/text.js && node --check bin/dsh-antigravity-login.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "install:local": "node scripts/install-local.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "antigravity",
    "cloud-code-assist",
    "oauth",
    "llm",
    "adapter"
  ],
  "author": "Aditya Deokar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aditya-deokar/dsh-antigravity.git"
  },
  "homepage": "https://github.com/aditya-deokar/dsh-antigravity#readme",
  "bugs": {
    "url": "https://github.com/aditya-deokar/dsh-antigravity/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-timeout": "*"
  },
  "peerDependenciesMeta": {
    "*": {
      "optional": true
    }
  }
}
